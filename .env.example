# server configuration
APP_NAME = scholar-backend
NODE_ENV = production
APP_PORT = 4020
MAX_MEMORY = 1024
MIN_MEMORY = 512
NUMBER_OF_PROXIES = 2
REQUEST_BODY_SIZE_LIMIT = 5mb
RATE_LIMIT_TIME_WINDOW_IN_MINUTE = 15
RATE_LIMIT_MAX_AMOUNT = 500
MAIN_DOMAIN = scholar.fleebug.com

# frontend urls
FRONTEND_MAIN_URL = https://scholar.fleebug.com

# backend urls
BACKEND_MAIN_URL = https://api.scholar.fleebug.com

# session (generate a random secret)
SESSION_SECRET = session-secret-here

# jwt (generate random secrets for each)
ACCESS_TOKEN_SECRET = access-token-secret-here
ACCESS_TOKEN_EXPIRES_IN = 1h
REFRESH_TOKEN_SECRET = refresh-token-secret-here
REFRESH_TOKEN_EXPIRES_IN = 3d
GENERAL_TOKEN_SECRET = general-token-secret-here
GENERAL_TOKEN_EXPIRES_IN = 1d

# mailer (configure with your email service)
MAIL_SERVICE = Gmail
MAIL_HOST = smtp.gmail.com
MAIL_PORT = 587
MAIL_USER = your-email@example.com
MAIL_PASSWORD = your-app-password

# emails (configure your business emails)
NO_REPLY_EMAIL = no-reply@example.com
HELP_EMAIL = help@example.com
SUPPORT_EMAIL = support@example.com
MARKETTING_EMAIL = marketing@example.com
INFO_EMAIL = info@example.com
SALES_EMAIL = sales@example.com
CAREER_EMAIL = career@example.com
OTHER_EMAIL = misc@example.com

# superadmin-account (configure your super admin)
SUPER_ADMIN_NAME = Super Admin
SUPER_ADMIN_PHONE = +9779812345678
SUPER_ADMIN_EMAIL = superadmin@scholar.fleebug.com
SUPER_ADMIN_PASSWORD = super-admin-password-here

# zoom (optional - only if using Zoom integration)
ZOOM_ACCOUNT_ID = your-zoom-account-id
ZOOM_CLIENT_ID = your-zoom-client-id
ZOOM_CLIENT_SECRET = your-zoom-client-secret

# whatsapp (optional - only if using WhatsApp integration)
WHATSAPP_API_URL = https://your-whatsapp-api-url
WHATSAPP_API_KEY = your-whatsapp-api-key

# oauth google (optional - only if using Google OAuth)
GOOGLE_CLIENT_ID = google-client-id-here
GOOGLE_CLIENT_SECRET = google-client-secret-here

# oauth linkedin (optional - only if using LinkedIn OAuth)
LINKEDIN_CLIENT_ID = linkedin-client-id-here
LINKEDIN_CLIENT_SECRET = linkedin-client-secret-here

# File Storage Configuration (cloudinary/local/both)
FILE_STORAGE_TARGET = cloudinary

# cloudinary (optional - only required if using cloudinary for file storage)
CLOUDINARY_CLOUD_NAME = scholar_prod
CLOUDINARY_API_KEY = cloudinary-api-key-here
CLOUDINARY_API_SECRET = cloudinary-api-secret-here

# database
DATABASE_DIALECT = postgres
DATABASE_SYNC_MODE = none # none/sync/alter/force

# cache - redis
REDIS_HOST = redis-host-here
REDIS_PORT = 6379
REDIS_USER = default
REDIS_PASSWORD = admin
REDIS_DATABASE = redis-database-here
REDIS_SSL = false

# db - postgres
POSTGRES_HOST = postgres-host-here
POSTGRES_PORT = 5432
POSTGRES_USER = postgres-user-here
POSTGRES_PASSWORD = postgres-password-here
POSTGRES_DATABASE = postgres-database-here
POSTGRES_SSL = false
POSTGRES_CA = pem-file-content
