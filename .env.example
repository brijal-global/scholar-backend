# server configuration
APP_NAME = your-project-name
NODE_ENV = local
APP_PORT = 4000
MAX_MEMORY = 2048
MIN_MEMORY = 512
NUMBER_OF_PROXIES = 2
REQUEST_BODY_SIZE_LIMIT = 5mb
RATE_LIMIT_TIME_WINDOW_IN_MINUTE = 15
RATE_LIMIT_MAX_AMOUNT = 500
MAIN_DOMAIN = example.com

# frontend urls
FRONTEND_MAIN_URL = https://example.com
FRONTEND_LOCAL_URL = http://localhost:3000

# backend urls
BACKEND_MAIN_URL = https://api.example.com

# session (generate a random secret)
SESSION_SECRET = your-session-secret-here

# jwt (generate random secrets for each)
ACCESS_TOKEN_SECRET = your-access-token-secret-here
ACCESS_TOKEN_EXPIRES_IN = 1h
REFRESH_TOKEN_SECRET = your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRES_IN = 3d
GENERAL_TOKEN_SECRET = your-general-token-secret-here
GENERAL_TOKEN_EXPIRES_IN = 1d

# mailer (configure with your email service)
MAIL_SERVICE = Gmail
MAIL_HOST = smtp.gmail.com
MAIL_PORT = 587
MAIL_USER = your-email@example.com
MAIL_PASSWORD = your-app-password

# emails (configure your business emails)
NO_REPLY_EMAIL = no-reply@example.com
HELP_EMAIL = help@example.com
SUPPORT_EMAIL = support@example.com
MARKETTING_EMAIL = marketing@example.com
INFO_EMAIL = info@example.com
SALES_EMAIL = sales@example.com
CAREER_EMAIL = career@example.com
OTHER_EMAIL = misc@example.com

# superadmin-account (configure your super admin)
SUPER_ADMIN_NAME = Super Admin
SUPER_ADMIN_PHONE = +1234567890
SUPER_ADMIN_EMAIL = superadmin@example.com
SUPER_ADMIN_PASSWORD = Super_ADMIN@123

# zoom (optional - only if using Zoom integration)
ZOOM_ACCOUNT_ID = your-zoom-account-id
ZOOM_CLIENT_ID = your-zoom-client-id
ZOOM_CLIENT_SECRET = your-zoom-client-secret

# whatsapp (optional - only if using WhatsApp integration)
WHATSAPP_API_URL = https://your-whatsapp-api-url
WHATSAPP_API_KEY = your-whatsapp-api-key

# oauth google (optional - only if using Google OAuth)
GOOGLE_CLIENT_ID = your-google-client-id
GOOGLE_CLIENT_SECRET = your-google-client-secret

# oauth linkedin (optional - only if using LinkedIn OAuth)
LINKEDIN_CLIENT_ID = your-linkedin-client-id
LINKEDIN_CLIENT_SECRET = your-linkedin-client-secret

# File Storage Configuration (cloudinary/local/both)
FILE_STORAGE_TARGET = cloudinary

# cloudinary (optional - only required if using cloudinary for file storage)
CLOUDINARY_CLOUD_NAME = your-cloud-name
CLOUDINARY_API_KEY = your-api-key
CLOUDINARY_API_SECRET = your-api-secret

# database
DATABASE_DIALECT = postgres
DATABASE_SYNC_MODE = none # none/sync/alter/force

# cache - redis
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_USER = your-username
REDIS_PASSWORD = your-password
REDIS_DATABASE = database-name
REDIS_SSL = false

# db - postgres
POSTGRES_HOST = localhost
POSTGRES_PORT = 5432
POSTGRES_USER = postgres
POSTGRES_PASSWORD = your-password
POSTGRES_DATABASE = scholar-db
POSTGRES_SSL = false
POSTGRES_CA = pem-file-content
